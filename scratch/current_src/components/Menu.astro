---
import { Image } from "astro:assets";
import { menuItems, menuCategories } from "../data/menu";
import { formatPrice } from "../utils/format";
---

<section id="menu" class="w-full bg-surface-container section-screen-fit section-divider">
  <div
    class="max-w-7xl mx-auto px-gutter-mobile md:px-margin-tablet lg:px-margin w-full flex flex-col justify-center my-auto gap-2 sm:gap-3.5 lg:gap-5 short:gap-1.5 ultra-short:gap-1"
  >
    <!-- Section Header & Deck Controls -->
    <div
      class="flex items-end justify-between mb-2 sm:mb-4 short:mb-1 ultra-short:mb-0.5 gap-2"
      data-animate
    >
      <div>
        <span
          class="font-label-md text-xs sm:text-label-md tracking-widest text-primary uppercase block mb-1 sm:mb-1.5 short:mb-0.5 font-semibold"
        >
          SELECCIÓN DE TEMPORADA
        </span>
        <h2
          class="font-headline-xl text-fluid-headline text-on-surface font-bold leading-tight"
        >
          Nuestro menú destacado
        </h2>
      </div>

      <!-- Accessible Deck Navigation for horizontal scroll (<lg) -->
      <div class="flex lg:hidden items-center gap-1.5 shrink-0">
        <button
          type="button"
          id="menu-prev-btn"
          aria-label="Ver platos anteriores"
          class="w-9 h-9 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-95 shadow-xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_left</span>
        </button>
        <button
          type="button"
          id="menu-next-btn"
          aria-label="Ver platos siguientes"
          class="w-9 h-9 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-95 shadow-xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Category Filter Tabs (Accessible Tablist) -->
    <div
      role="tablist"
      aria-label="Filtrar platos del menú de temporada"
      class="flex items-center gap-2 sm:gap-2.5 mb-3 sm:mb-4 short:mb-1.5 ultra-short:mb-1 overflow-x-auto no-scrollbar py-1 short:py-0 -mx-gutter-mobile px-gutter-mobile sm:mx-0 sm:px-0 flex-nowrap sm:flex-wrap shrink-0"
      data-animate
    >
      {
        menuCategories.map((cat, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${cat.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-menu-filter={cat.id}
            class={`menu-filter-btn shrink-0 whitespace-nowrap px-3.5 py-2 sm:px-4 sm:py-2 short:px-3 short:py-1 short:text-xs rounded-full font-label-md text-xs sm:text-sm font-semibold transition-all duration-300 cursor-pointer min-h-11 short:min-h-8 inline-flex items-center justify-center ${
              i === 0
                ? "bg-primary text-on-primary shadow-sm active-tab"
                : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest border border-outline-variant/30"
            }`}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <!-- Cards: Horizontal Swipe Deck on Mobile (<lg), Responsive 4 Columns on Desktop (lg+) -->
    <div
      id="menu-grid"
      class="flex lg:grid lg:grid-cols-4 gap-3.5 sm:gap-4 lg:gap-6 short:gap-3 ultra-short:gap-2 overflow-x-auto no-scrollbar snap-x snap-mandatory lg:snap-none -mx-gutter-mobile px-gutter-mobile sm:mx-0 sm:px-0 pb-2 lg:pb-0 items-stretch"
      tabindex="0"
      role="region"
      aria-label="Catálogo de platos del menú"
    >
      {
        menuItems.map((item, i) => (
          <div
            class="menu-item-card w-[80vw] max-w-74 sm:w-68 md:w-72 lg:w-auto shrink-0 lg:shrink snap-start lg:snap-align-none group bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/40 rounded-2xl overflow-hidden shadow-[0_4px_20px_-2px_rgba(43,33,26,0.06)] hover:shadow-[0_16px_36px_-4px_rgba(43,33,26,0.14)] transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col justify-between"
            data-category={item.category}
            data-animate
            style={`transition-delay: ${i * 70}ms`}
          >
            <div class="relative aspect-16/10 max-h-[min(18svh,160px)] sm:max-h-[min(24svh,190px)] short:max-h-[105px] ultra-short:max-h-[80px] overflow-hidden bg-surface-container-high shrink-0">
              <Image
                alt={item.imageAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                src={item.image}
                loading="lazy"
                decoding="async"
                densities={[1, 2]}
              />
              <span class="absolute top-2 right-2 bg-surface-container-lowest/95 backdrop-blur-md text-on-surface font-semibold text-[11px] sm:text-xs px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full uppercase tracking-wider shadow-sm border border-black/5">
                {item.badge}
              </span>
            </div>
            <div class="p-3.5 sm:p-4 short:p-2.5 ultra-short:p-2 flex flex-col grow justify-between">
              <div>
                <div class="flex items-start justify-between gap-2 mb-1.5 short:mb-0.5">
                  <h3 class="font-serif font-bold text-sm sm:text-base lg:text-lg short:text-sm ultra-short:text-xs text-on-surface group-hover:text-primary transition-colors leading-snug">
                    {item.name}
                  </h3>
                  <span class="bg-primary/10 text-primary font-bold px-2 py-0.5 sm:px-2.5 sm:py-1 short:px-1.5 short:py-0.5 rounded-lg text-xs sm:text-sm short:text-xs whitespace-nowrap shrink-0">
                    {formatPrice(item.numericPrice)}
                  </span>
                </div>
                <p class="font-body-sm text-xs short:text-[11px] ultra-short:text-[10px] text-tertiary mb-2 sm:mb-3 short:mb-1 ultra-short:mb-0.5 leading-relaxed short:leading-tight line-clamp-2">
                  {item.description}
                </p>
              </div>
              <div class="pt-2 short:pt-1 ultra-short:pt-0.5 border-t border-outline-variant/20 flex items-center justify-between text-secondary font-label-sm text-[11px] sm:text-xs short:text-[10px]">
                <span class="inline-flex items-center gap-1 font-medium">
                  <span class="material-symbols-outlined text-[15px] sm:text-[17px] short:text-[14px]">
                    {item.icon}
                  </span>
                  {item.iconLabel}
                </span>
                <span class="material-symbols-outlined text-outline-variant group-hover:text-primary group-hover:translate-x-1 transition-all duration-200 text-[15px]">
                  arrow_forward
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bottom Callout: always visible on the same screen -->
    <div class="mt-2.5 sm:mt-4 short:mt-1.5 ultra-short:mt-1 text-center shrink-0" data-animate>
      <a
        href="#reservas"
        class="w-full sm:w-auto min-h-11 short:min-h-8 inline-flex items-center justify-center gap-2 px-5 py-2.5 sm:px-8 sm:py-3 short:px-4 short:py-1.5 rounded-full bg-surface-container-lowest border-2 border-primary/30 hover:border-primary text-primary hover:bg-primary hover:text-on-primary font-title-md font-semibold text-xs sm:text-sm short:text-xs shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5 active:scale-95 group text-center"
      >
        <span class="material-symbols-outlined text-[17px] sm:text-[18px]">menu_book</span>
        <span>Ver carta completa en sala</span>
        <span
          class="material-symbols-outlined text-[15px] sm:text-[16px] transform group-hover:translate-x-1 transition-transform"
        >
          arrow_forward
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  function setupMenuFilters() {
    const filterButtons =
      document.querySelectorAll<HTMLButtonElement>(".menu-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".menu-item-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetCategory = btn.getAttribute("data-menu-filter");

        // Update active tab styles
        filterButtons.forEach((b) => {
          b.setAttribute("aria-selected", "false");
          b.classList.remove(
            "bg-primary",
            "text-on-primary",
            "shadow-sm",
            "active-tab",
          );
          b.classList.add(
            "bg-surface-container-lowest",
            "text-on-surface-variant",
            "border",
            "border-outline-variant/30",
          );
        });

        btn.setAttribute("aria-selected", "true");
        btn.classList.add(
          "bg-primary",
          "text-on-primary",
          "shadow-sm",
          "active-tab",
        );
        btn.classList.remove(
          "bg-surface-container-lowest",
          "text-on-surface-variant",
          "border",
          "border-outline-variant/30",
        );

        // Filter cards
        cards.forEach((card) => {
          const itemCat = card.getAttribute("data-category");
          if (targetCategory === "todos" || itemCat === targetCategory) {
            card.style.display = "flex";
            card.style.opacity = "0";
            card.style.transform = "scale(0.96)";
            requestAnimationFrame(() => {
              card.style.transition =
                "opacity 300ms ease, transform 300ms ease";
              card.style.opacity = "1";
              card.style.transform = "scale(1)";
            });
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  }

  function setupMenuDeckNavigation() {
    const grid = document.getElementById("menu-grid");
    const prevBtn = document.getElementById("menu-prev-btn");
    const nextBtn = document.getElementById("menu-next-btn");

    if (!grid) return;

    function getScrollStep() {
      const firstCard = grid.querySelector<HTMLElement>(".menu-item-card");
      return firstCard ? firstCard.offsetWidth + 16 : 280;
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        grid.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        grid.scrollBy({ left: getScrollStep(), behavior: "smooth" });
      });
    }

    // Keyboard arrow navigation
    grid.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        grid.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        grid.scrollBy({ left: getScrollStep(), behavior: "smooth" });
      }
    });
  }

  // Setup on load and Astro page transitions if applicable
  setupMenuFilters();
  setupMenuDeckNavigation();
  document.addEventListener("astro:page-load", () => {
    setupMenuFilters();
    setupMenuDeckNavigation();
  });
</script>
