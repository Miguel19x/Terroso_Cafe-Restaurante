---
import { Image } from 'astro:assets';
import cafeImg from '../assets/café.png';
import sourdoughImg from '../assets/croissant & sourdough.jpg';
import foundersImg from '../assets/fundadores.jpg';
---

<section
  id="historia"
  class="w-full bg-surface-container section-screen-fit section-divider overflow-x-clip relative"
>
  <div class="max-w-7xl mx-auto px-gutter-mobile md:px-margin-tablet lg:px-margin w-full flex flex-col justify-center my-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 sm:gap-6 lg:gap-12 short:gap-4 ultra-short:gap-3 items-center">

      <!-- Story Narrative (Col 1-6) -->
      <div class="md:col-span-6 flex flex-col justify-center" data-animate="slide-right">
        <span class="font-label-md text-xs sm:text-label-md tracking-widest text-primary uppercase block mb-1 sm:mb-2 short:mb-0.5 font-semibold">
          FILOSOFÍA Y ORIGEN
        </span>
        <h2 class="font-headline-xl text-fluid-headline text-on-surface leading-tight mb-1.5 sm:mb-2.5 short:mb-1 ultra-short:mb-0.5 font-bold">
          Nacidos de la tierra, moldeados por la paciencia
        </h2>

        <div class="space-y-2 sm:space-y-3 short:space-y-1 font-body-md text-xs sm:text-sm lg:text-base short:text-xs text-tertiary leading-relaxed short:leading-snug">
          <p>
            Terroso nació como un refugio botánico y un humilde taller de fermentación en Altamira. Comenzamos con un pequeño tostador manual de 1 kilo y la convicción de honrar el trabajo invisible de los caficultores andinos.
          </p>
          <p class="hidden sm:block">
            En nuestra cocina, el budare y el fogón sustituyen a las prisas, y cada receta es un homenaje a las manos tachirenses que cultivan nuestra despensa viva.
          </p>
        </div>

        <!-- 3 Milestone Pillars -->
        <div class="grid grid-cols-3 gap-2 sm:gap-3 short:gap-1.5 my-2.5 sm:my-4 short:my-1.5 ultra-short:my-1">
          <div class="bg-surface-container-lowest p-2 sm:p-3 short:p-1.5 short:py-1 rounded-xl border border-outline-variant/25 text-center shadow-xs">
            <span class="font-serif font-bold text-primary text-sm sm:text-base lg:text-lg short:text-xs block">2018</span>
            <span class="text-[10px] sm:text-xs short:text-[9px] text-tertiary block font-medium">Taller Altamira</span>
          </div>
          <div class="bg-surface-container-lowest p-2 sm:p-3 short:p-1.5 short:py-1 rounded-xl border border-outline-variant/25 text-center shadow-xs">
            <span class="font-serif font-bold text-primary text-sm sm:text-base lg:text-lg short:text-xs block">Andes</span>
            <span class="text-[10px] sm:text-xs short:text-[9px] text-tertiary block font-medium">Trato directo</span>
          </div>
          <div class="bg-surface-container-lowest p-2 sm:p-3 short:p-1.5 short:py-1 rounded-xl border border-outline-variant/25 text-center shadow-xs">
            <span class="font-serif font-bold text-primary text-sm sm:text-base lg:text-lg short:text-xs block">Horno</span>
            <span class="text-[10px] sm:text-xs short:text-[9px] text-tertiary block font-medium">Masa Madre</span>
          </div>
        </div>

        <!-- Unified Founders & Manifesto Quote Card -->
        <div class="flex items-center gap-3 short:gap-2 bg-surface-container-lowest/90 backdrop-blur-xs p-2.5 sm:p-3.5 short:p-2 short:py-1.5 rounded-2xl border border-outline-variant/25 shadow-xs mt-1 sm:mt-3 short:mt-1 ultra-short:mt-0.5">
          <div class="w-10 h-10 sm:w-12 sm:h-12 short:w-8 short:h-8 rounded-full overflow-hidden bg-surface-container-high shrink-0 border-2 border-primary/25 shadow-xs ring-2 ring-surface-container">
            <Image
              alt="Valentina y Rodrigo, fundadores y maestros tostadores de Terroso"
              class="w-full h-full object-cover object-top"
              src={foundersImg}
              loading="lazy"
              decoding="async"
              densities={[1, 2]}
            />
          </div>
          <div class="min-w-0 grow">
            <blockquote class="font-serif italic text-xs sm:text-sm short:text-xs text-on-surface leading-snug">
              “El café no se apresura, se vive.”
            </blockquote>
            <p class="text-[11px] sm:text-xs short:text-[10px] text-tertiary font-medium mt-0.5">
              Valentina &amp; Rodrigo · <span class="text-primary font-semibold">Fundadores</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Story Visual Mosaic (Col 7-12) -->
      <div class="md:col-span-6 relative flex items-center justify-center md:justify-end mt-2 md:mt-0" data-animate="slide-left">
        <div
          class="relative w-full max-w-95 lg:max-w-115 rounded-2xl sm:rounded-3xl overflow-hidden shadow-[0_20px_40px_-8px_rgba(43,33,26,0.16)] border border-outline-variant/20 bg-surface-container-high max-h-[min(20svh,190px)] sm:max-h-none short:max-h-[220px] ultra-short:max-h-[170px] aspect-16/9 sm:aspect-4/3 short:aspect-16/9"
        >
          <Image
            alt="Barista artesanal preparando café filtrado V60 de origen andino venezolano"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            src={cafeImg}
            loading="lazy"
            decoding="async"
            densities={[1, 2]}
          />

          <!-- Floating Badge: Comercio Justo (Top-Left) -->
          <div class="absolute top-2 left-2 sm:top-3.5 sm:left-3.5 short:top-2 short:left-2 bg-surface-container-lowest/95 backdrop-blur-md px-2 py-0.5 sm:px-3 sm:py-1.5 short:px-2 short:py-0.5 rounded-xl shadow-md border border-outline-variant/20 flex items-center gap-1.5 sm:gap-2">
            <span class="material-symbols-outlined text-primary text-[14px] sm:text-[17px] short:text-[14px]">handshake</span>
            <div>
              <p class="font-label-sm text-[9px] sm:text-[11px] short:text-[9px] uppercase tracking-wider font-semibold text-primary">Comercio Justo</p>
              <p class="text-[9px] sm:text-[11px] short:text-[9px] text-on-surface font-medium leading-none">Fincas Andinas 100%</p>
            </div>
          </div>

          <!-- Floating Badge: Refugio Botánico (Bottom-Left, hidden on ultra-short) -->
          <div class="absolute bottom-2 left-2 sm:bottom-3.5 sm:left-3.5 short:bottom-2 short:left-2 ultra-short:hidden bg-surface-container-lowest/95 backdrop-blur-md px-2 py-0.5 sm:px-3 sm:py-1.5 short:px-2 short:py-0.5 rounded-xl shadow-md border border-outline-variant/20 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-secondary text-[14px] sm:text-[16px]">potted_plant</span>
            <span class="text-[9px] sm:text-[11px] font-semibold text-on-surface">Refugio Botánico</span>
          </div>

          <!-- Overlapping Sourdough Photo Inset (hidden on ultra-short to maximize photo clarity) -->
          <div class="hidden sm:block ultra-short:hidden absolute bottom-3.5 right-3.5 short:bottom-2 short:right-2 w-24 h-24 lg:w-32 lg:h-32 short:w-20 short:h-20 rounded-2xl overflow-hidden shadow-lg ring-2 ring-surface-container border border-outline-variant/20">
            <Image
              alt="Detalle de pan de masa madre y croissant recién salidos del horno"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              src={sourdoughImg}
              loading="lazy"
              decoding="async"
              densities={[1, 2]}
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

