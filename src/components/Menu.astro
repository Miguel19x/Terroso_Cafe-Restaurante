---
import { Image } from "astro:assets";
import { menuItems, menuCategories } from "../data/menu";
import { formatPrice } from "../utils/format";
---

<section id="menu" class="w-full bg-surface-container section-screen-fit section-divider">
  <div
    class="site-container px-gutter-mobile md:px-margin-tablet lg:px-margin w-full flex flex-col justify-center my-auto gap-[clamp(0.5rem,1.4svh,1.25rem)]"
  >
    <!-- Section Header & Deck Controls -->
    <div
      class="flex items-end justify-between mb-[clamp(0.375rem,1svh,1rem)] gap-2"
      data-animate
    >
      <div>
        <span
          class="font-label-md text-xs sm:text-label-md tracking-widest text-primary uppercase block mb-1 sm:mb-1.5 font-semibold"
        >
          SELECCIÓN DE TEMPORADA
        </span>
        <h2
          class="font-headline-xl text-fluid-headline text-on-surface font-bold leading-tight"
        >
          Nuestro menú destacado
        </h2>
      </div>

      <!-- Accessible Deck Navigation for horizontal scroll (<lg) -->
      <div class="flex lg:hidden items-center gap-1.5 shrink-0">
        <button
          type="button"
          id="menu-prev-btn"
          aria-label="Ver platos anteriores"
          class="w-9 h-9 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-95 shadow-xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_left</span>
        </button>
        <button
          type="button"
          id="menu-next-btn"
          aria-label="Ver platos siguientes"
          class="w-9 h-9 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface hover:text-primary flex items-center justify-center transition-all cursor-pointer active:scale-95 shadow-xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Category Filter Tabs (Accessible Tablist) -->
    <div
      role="tablist"
      aria-label="Filtrar platos del menú de temporada"
      class="flex items-center gap-2 sm:gap-2.5 mb-[clamp(0.5rem,1.2svh,1rem)] overflow-x-auto overflow-y-hidden no-scrollbar py-1 flex-nowrap sm:flex-wrap shrink-0 touch-pan-x select-none"
      data-animate
    >
      {
        menuCategories.map((cat, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${cat.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? "0" : "-1"}
            data-menu-filter={cat.id}
            class={`menu-filter-btn shrink-0 whitespace-nowrap px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full font-label-md text-xs sm:text-sm font-semibold transition-all duration-300 cursor-pointer min-h-[clamp(2.25rem,4svh,2.75rem)] inline-flex items-center justify-center ${
              i === 0
                ? "bg-primary text-on-primary shadow-sm active-tab"
                : "bg-surface-container-lowest text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest border border-outline-variant/30"
            }`}
          >
            {cat.label}
          </button>
        ))
      }
    </div>

    <!-- Cards: Horizontal Swipe Deck on Mobile (<lg), Responsive 4 Columns on Desktop (lg+) -->
    <div
      id="menu-grid"
      class="flex lg:grid lg:grid-cols-4 gap-[clamp(0.75rem,1.6svh,1.5rem)] overflow-x-auto overflow-y-hidden no-scrollbar snap-x snap-mandatory lg:snap-none pt-2 pb-3 lg:pt-0 lg:pb-0 items-stretch select-none touch-pan-x"
      tabindex="0"
      role="region"
      aria-label="Catálogo de platos del menú"
    >
      {
        menuItems.map((item, i) => (
          <div
            draggable="false"
            class="menu-item-card w-[80vw] max-w-74 sm:w-68 md:w-72 lg:w-auto shrink-0 lg:shrink snap-start lg:snap-align-none group bg-surface-container-lowest border border-outline-variant/30 hover:border-primary/40 rounded-2xl overflow-hidden shadow-[0_4px_20px_-2px_rgba(43,33,26,0.06)] hover:shadow-[0_16px_36px_-4px_rgba(43,33,26,0.14)] transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col justify-between select-none"
            data-category={item.category}
            data-animate
            style={`transition-delay: ${i * 70}ms`}
          >
            <div class="relative aspect-16/10 h-[clamp(95px,18svh,190px)] max-h-[clamp(95px,18svh,190px)] overflow-hidden bg-surface-container-high shrink-0 select-none" style="aspect-ratio: 16/10;">
              <Image
                alt={item.imageAlt}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 pointer-events-none select-none"
                src={item.image}
                width={600}
                height={375}
                quality={70}
                format="avif"
                widths={[300, 450, 600]}
                sizes="(max-width: 640px) 280px, (max-width: 1024px) 340px, 400px"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                draggable="false"
              />
              <span class="absolute top-2 right-2 bg-surface-container-lowest/95 backdrop-blur-md text-on-surface font-semibold text-[11px] sm:text-xs px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full uppercase tracking-wider shadow-sm border border-black/5">
                {item.badge}
              </span>
            </div>
            <div class="p-[clamp(0.625rem,1.4svh,1rem)] sm:p-4 flex flex-col grow justify-between">
              <div>
                <div class="flex items-start justify-between gap-2 mb-1.5">
                  <h3 class="font-serif font-bold text-sm sm:text-base lg:text-lg text-on-surface group-hover:text-primary transition-colors leading-snug">
                    {item.name}
                  </h3>
                  <span class="bg-primary/10 text-primary font-bold px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-lg text-xs sm:text-sm whitespace-nowrap shrink-0">
                    {formatPrice(item.numericPrice)}
                  </span>
                </div>
                <p class="font-body-sm text-xs text-tertiary mb-[clamp(0.25rem,0.8svh,0.75rem)] leading-relaxed line-clamp-2">
                  {item.description}
                </p>
              </div>
              <div class="pt-[clamp(0.25rem,0.6svh,0.5rem)] border-t border-outline-variant/20 flex items-center justify-between text-secondary font-label-sm text-[11px] sm:text-xs">
                <span class="inline-flex items-center gap-1 font-medium">
                  <span class="material-symbols-outlined text-[15px] sm:text-[17px]">
                    {item.icon}
                  </span>
                  {item.iconLabel}
                </span>
                <span class="material-symbols-outlined text-outline-variant group-hover:text-primary group-hover:translate-x-1 transition-transform duration-200 text-[15px]">
                  arrow_forward
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Disclaimer Legal y Moneda Local (I18N-02 / BCV) -->
    <div class="mt-[clamp(0.375rem,0.8svh,0.75rem)] text-center text-xs text-on-surface-variant/80 border-t border-outline-variant/20 pt-2.5 max-w-2xl mx-auto space-y-0.5 shrink-0" data-animate>
      <p class="font-medium text-on-surface-variant text-[11px] sm:text-xs">
        * Precios expresados en USD ($). Se reciben pagos en Bolívares (VES) a la tasa oficial del Banco Central de Venezuela (BCV) del día.
      </p>
      <p class="text-[10px] sm:text-[11px] text-tertiary">
        Aceptamos Pago Móvil, tarjetas de débito/crédito nacionales e internacionales y divisas en efectivo.
      </p>
    </div>

    <!-- Bottom Callout: always visible on the same screen -->
    <div class="mt-[clamp(0.5rem,1.2svh,1rem)] sm:mt-4 text-center shrink-0" data-animate>
      <a
        href="#reservas"
        class="w-full sm:w-auto min-h-[clamp(2.5rem,4.2svh,2.75rem)] inline-flex items-center justify-center gap-2 px-5 py-2 sm:px-8 sm:py-3 rounded-full bg-surface-container-lowest border-2 border-primary/30 hover:border-primary text-primary hover:bg-primary hover:text-on-primary font-title-md font-semibold text-xs sm:text-sm shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5 active:scale-95 group text-center"
      >
        <span class="material-symbols-outlined text-[17px] sm:text-[18px]">menu_book</span>
        <span>Ver carta completa en sala</span>
        <span
          class="material-symbols-outlined text-[15px] sm:text-[16px] transform group-hover:translate-x-1 transition-transform"
        >
          arrow_forward
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  function setupMenuFilters() {
    const filterButtons =
      document.querySelectorAll<HTMLButtonElement>(".menu-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".menu-item-card");
    const tablist = document.querySelector('[role="tablist"]');

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetCategory = btn.getAttribute("data-menu-filter");

        // Update active tab styles & ARIA attributes (A11Y-05)
        filterButtons.forEach((b) => {
          b.setAttribute("aria-selected", "false");
          b.setAttribute("tabindex", "-1");
          b.classList.remove(
            "bg-primary",
            "text-on-primary",
            "shadow-sm",
            "active-tab",
          );
          b.classList.add(
            "bg-surface-container-lowest",
            "text-on-surface-variant",
            "border",
            "border-outline-variant/30",
          );
        });

        btn.setAttribute("aria-selected", "true");
        btn.setAttribute("tabindex", "0");
        btn.classList.add(
          "bg-primary",
          "text-on-primary",
          "shadow-sm",
          "active-tab",
        );
        btn.classList.remove(
          "bg-surface-container-lowest",
          "text-on-surface-variant",
          "border",
          "border-outline-variant/30",
        );

        // Filter cards
        cards.forEach((card) => {
          const itemCat = card.getAttribute("data-category");
          if (targetCategory === "todos" || itemCat === targetCategory) {
            card.style.display = "flex";
            card.style.opacity = "0";
            card.style.transform = "scale(0.96)";
            requestAnimationFrame(() => {
              card.style.transition =
                "opacity 300ms ease, transform 300ms ease";
              card.style.opacity = "1";
              card.style.transform = "scale(1)";
            });
          } else {
            card.style.display = "none";
          }
        });
      });
    });

    // Keyboard Arrow Navigation for WAI-ARIA Tabs pattern (A11Y-05)
    if (tablist) {
      tablist.addEventListener("keydown", (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        const buttonsArray = Array.from(filterButtons);
        const currentIndex = buttonsArray.indexOf(document.activeElement as HTMLButtonElement);

        if (currentIndex === -1) return;

        let nextIndex = currentIndex;

        if (keyEvent.key === "ArrowRight") {
          keyEvent.preventDefault();
          nextIndex = (currentIndex + 1) % buttonsArray.length;
        } else if (keyEvent.key === "ArrowLeft") {
          keyEvent.preventDefault();
          nextIndex = (currentIndex - 1 + buttonsArray.length) % buttonsArray.length;
        } else if (keyEvent.key === "Home") {
          keyEvent.preventDefault();
          nextIndex = 0;
        } else if (keyEvent.key === "End") {
          keyEvent.preventDefault();
          nextIndex = buttonsArray.length - 1;
        }

        if (nextIndex !== currentIndex) {
          const nextBtn = buttonsArray[nextIndex];
          nextBtn.focus();
          nextBtn.click();
        }
      });
    }
  }

  function setupMenuDeckNavigation() {
    const grid = document.getElementById("menu-grid");
    const prevBtn = document.getElementById("menu-prev-btn");
    const nextBtn = document.getElementById("menu-next-btn");

    if (!grid) return;

    function getScrollStep() {
      const firstCard = grid?.querySelector<HTMLElement>(".menu-item-card");
      return firstCard ? firstCard.offsetWidth + 16 : 280;
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        grid.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        grid.scrollBy({ left: getScrollStep(), behavior: "smooth" });
      });
    }

    // Keyboard arrow navigation
    grid.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        grid.scrollBy({ left: -getScrollStep(), behavior: "smooth" });
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        grid.scrollBy({ left: getScrollStep(), behavior: "smooth" });
      }
    });
  }

  // Setup on load and Astro page transitions if applicable
  setupMenuFilters();
  setupMenuDeckNavigation();
  document.addEventListener("astro:page-load", () => {
    setupMenuFilters();
    setupMenuDeckNavigation();
  });
</script>
