---
import { testimonials } from '../data/testimonials';
import { formatNumber, formatRating } from '../utils/format';
---

<section
  id="testimonios"
  class="w-full bg-surface-container-high/40 border-t border-outline-variant/20 section-screen-fit section-divider"
  aria-roledescription="carousel"
  aria-label="Opiniones de clientes"
>
  <div class="site-container px-gutter-mobile md:px-margin-tablet lg:px-margin w-full flex flex-col justify-center my-auto gap-4 sm:gap-6 lg:gap-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-2 sm:mb-4 lg:mb-6" data-animate>
      <!-- Trust Rating Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-surface-container-lowest border border-outline-variant/30 text-[10px] sm:text-xs text-secondary font-semibold mb-1.5 sm:mb-2.5 shadow-xs">
        <div class="flex text-primary">
          {[1, 2, 3, 4, 5].map(() => (
            <span class="material-symbols-outlined material-symbols-fill text-[13px] sm:text-[15px] text-primary">star</span>
          ))}
        </div>
        <span class="text-on-surface/80">{formatRating(4.9)} / 5 · Más de {formatNumber(1200)} reseñas en sala</span>
      </div>

      <span class="font-label-md text-xs sm:text-label-md tracking-widest text-primary uppercase block mb-1 sm:mb-1.5 font-semibold">
        VOCES DE NUESTRA COMUNIDAD
      </span>
      <h2 class="font-headline-xl text-fluid-headline text-on-surface font-bold tracking-tight mb-1 sm:mb-2">
        Palabras de quienes nos visitan
      </h2>
      <p class="font-body-md text-xs sm:text-sm md:text-body-md text-tertiary max-w-lg mx-auto leading-relaxed line-clamp-2 sm:line-clamp-none">
        Historias cotidianas, pausas conscientes y momentos compartidos alrededor de una mesa viva y un café recién servido.
      </p>
    </div>

    <!-- Testimonials Slider (Mobile) / Grid (Desktop) -->
    <div class="relative w-full">
      <div
        id="testimonials-track"
        role="region"
        aria-live="polite"
        aria-label="Opiniones de clientes"
        tabindex="0"
        class="flex md:grid md:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 overflow-x-auto overflow-y-hidden md:overflow-visible snap-x snap-mandatory scroll-smooth pt-2 pb-4 sm:pb-4 md:pt-0 md:pb-0 no-scrollbar outline-none focus-visible:ring-2 focus-visible:ring-primary/40 rounded-2xl items-stretch select-none touch-pan-x"
      >
        {testimonials.map((t, i) => {
          const initials = t.name.split(" ").map(n => n[0]).join("").slice(0, 2);
          return (
            <div
              draggable="false"
              class="testimonial-card w-[82vw] max-w-85 md:w-auto md:max-w-none shrink-0 md:shrink snap-center md:snap-align-none relative bg-surface-container-lowest p-5 sm:p-6 rounded-2xl border border-outline-variant/30 hover:border-primary/40 shadow-[0_4px_20px_-2px_rgba(43,33,26,0.05)] hover:shadow-[0_16px_36px_-4px_rgba(43,33,26,0.12)] transition-all duration-300 transform hover:-translate-y-1 flex flex-col justify-between group overflow-hidden h-full select-none"
              data-testimonial-index={i}
              role="tabpanel"
              id={`testimonial-card-${i}`}
              aria-labelledby={`testimonial-dot-${i}`}
              data-animate
              style={`transition-delay: ${i * 90}ms`}
            >
              <!-- Watermark decorative quote mark -->
              <span class="material-symbols-outlined absolute -top-1 -right-1 text-primary/10 text-5xl sm:text-7xl select-none pointer-events-none group-hover:text-primary/20 transition-colors duration-300" aria-hidden="true">
                format_quote
              </span>

              <div class="relative z-10 flex flex-col grow">
                <!-- Top Row: 5 Stars Rating & Verified Badge -->
                <div class="flex items-center justify-between gap-2 mb-3 sm:mb-4">
                  <div class="flex items-center gap-0.5 text-primary" role="img" aria-label="Calificación de 5 estrellas">
                    {[1, 2, 3, 4, 5].map(() => (
                      <span class="material-symbols-outlined material-symbols-fill text-[14px] sm:text-[17px] text-primary">star</span>
                    ))}
                  </div>
                  {t.verified && (
                    <span class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-secondary bg-secondary/10 px-2.5 py-1 rounded-full">
                      <span class="material-symbols-outlined text-[13px] sm:text-[14px]">verified</span>
                      Visita verificada
                    </span>
                  )}
                </div>

                <!-- Quote content -->
                <blockquote class="font-serif italic text-on-surface/90 text-xs sm:text-sm lg:text-base leading-relaxed mb-3 sm:mb-4 grow line-clamp-4 md:line-clamp-none">
                  “{t.quote}”
                </blockquote>

                <!-- Dish Favorite Tag -->
                {t.dishFavorite && (
                  <div class="mb-3 sm:mb-4 inline-flex items-center gap-1.5 text-[11px] sm:text-xs text-primary font-medium bg-primary/5 px-2.5 py-1 rounded-lg border border-primary/10 self-start">
                    <span class="material-symbols-outlined text-[14px] sm:text-[15px]">restaurant</span>
                    <span>{t.dishFavorite}</span>
                  </div>
                )}
              </div>

              <!-- Author info -->
              <div class="pt-3 sm:pt-4 border-t border-outline-variant/20 flex items-center gap-2.5 sm:gap-3 relative z-10">
                <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-primary/10 text-primary font-serif font-bold text-xs sm:text-sm flex items-center justify-center shrink-0 border border-primary/20">
                  {initials}
                </div>
                <div>
                  <p class="font-title-md text-xs sm:text-sm text-on-surface font-semibold leading-tight">{t.name}</p>
                  <p class="font-body-sm text-[11px] sm:text-xs text-tertiary mt-0.5">{t.role}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Accessible Carousel Navigation Controls (Mobile only) -->
      <div
        id="testimonials-controls"
        class="flex md:hidden items-center justify-center gap-3 pt-3"
        role="group"
        aria-label="Navegación del carrusel"
      >
        <button
          type="button"
          id="testimonial-prev-btn"
          aria-label="Testimonio anterior"
          aria-controls="testimonials-track"
          class="w-8 h-8 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface hover:text-primary hover:border-primary/40 flex items-center justify-center transition-all cursor-pointer active:scale-95 shadow-xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_left</span>
        </button>

        <!-- Dot Indicators -->
        <div
          role="tablist"
          aria-label="Selector de testimonios"
          class="flex items-center gap-1.5"
        >
          {testimonials.map((_, i) => (
            <button
              type="button"
              role="tab"
              id={`testimonial-dot-${i}`}
              aria-controls={`testimonial-card-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-label={`Ver testimonio ${i + 1} de ${testimonials.length}`}
              data-dot-index={i}
              class={`testimonial-dot h-2.5 rounded-full transition-all duration-300 cursor-pointer ${
                i === 0 ? "w-6 bg-primary" : "w-2.5 bg-outline-variant/40 hover:bg-outline-variant"
              }`}
            />
          ))}
        </div>

        <button
          type="button"
          id="testimonial-next-btn"
          aria-label="Testimonio siguiente"
          aria-controls="testimonials-track"
          class="w-8 h-8 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-on-surface hover:text-primary hover:border-primary/40 flex items-center justify-center transition-all cursor-pointer active:scale-95 shadow-xs"
        >
          <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Community Feedback Strip -->
    <div
      class="mt-6 sm:mt-8 pt-4 sm:pt-5 border-t border-outline-variant/20 flex flex-wrap items-center justify-center gap-2.5 sm:gap-6 text-center text-secondary font-label-md text-[11px] sm:text-xs shrink-0"
      data-animate
    >
      <div class="flex items-center gap-1">
        <span class="material-symbols-outlined text-primary text-[15px] sm:text-[17px]">recommend</span>
        <span class="text-on-surface/80">98% de satisfacción</span>
      </div>
      <div class="w-1.5 h-1.5 rounded-full bg-outline-variant/40 hidden sm:block"></div>
      <div class="flex items-center gap-1">
        <span class="material-symbols-outlined text-primary text-[15px] sm:text-[17px]">rate_review</span>
        <span class="text-on-surface/80">1.200+ reseñas verificadas</span>
      </div>
      <div class="w-1.5 h-1.5 rounded-full bg-outline-variant/40 hidden sm:block"></div>
      <div class="flex items-center gap-1">
        <span class="material-symbols-outlined text-primary text-[15px] sm:text-[17px]">volunteer_activism</span>
        <span class="text-on-surface/80">Servicio cercano en Altamira</span>
      </div>
    </div>
  </div>
</section>

<script>
  function setupTestimonialsCarousel() {
    const track = document.getElementById("testimonials-track");
    const prevBtn = document.getElementById("testimonial-prev-btn");
    const nextBtn = document.getElementById("testimonial-next-btn");
    const dots = document.querySelectorAll<HTMLButtonElement>(".testimonial-dot");
    const cards = document.querySelectorAll<HTMLElement>(".testimonial-card");

    if (!track || cards.length === 0) return;

    let currentIndex = 0;

    function updateDots(index: number) {
      dots.forEach((dot, i) => {
        const isSelected = i === index;
        dot.setAttribute("aria-selected", isSelected ? "true" : "false");
        if (isSelected) {
          dot.classList.add("w-6", "bg-primary");
          dot.classList.remove("w-2.5", "bg-outline-variant/40");
        } else {
          dot.classList.remove("w-6", "bg-primary");
          dot.classList.add("w-2.5", "bg-outline-variant/40");
        }
      });
      currentIndex = index;
    }

    function scrollToIndex(index: number) {
      if (window.innerWidth >= 768) return;
      if (index < 0) index = cards.length - 1;
      if (index >= cards.length) index = 0;
      const targetCard = cards[index];
      if (targetCard) {
        targetCard.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
        updateDots(index);
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => scrollToIndex(currentIndex - 1));
    }
    if (nextBtn) {
      nextBtn.addEventListener("click", () => scrollToIndex(currentIndex + 1));
    }

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const targetIdx = parseInt(dot.getAttribute("data-dot-index") || "0", 10);
        scrollToIndex(targetIdx);
      });
    });

    // Keyboard arrow navigation (mobile only)
    track.addEventListener("keydown", (e: KeyboardEvent) => {
      if (window.innerWidth >= 768) return;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        scrollToIndex(currentIndex - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        scrollToIndex(currentIndex + 1);
      }
    });

    // Scroll listener to update active dot when user swipes on mobile
    let scrollTimeout: ReturnType<typeof setTimeout>;
    track.addEventListener("scroll", () => {
      if (window.innerWidth >= 768) return;
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const trackRect = track.getBoundingClientRect();
        const trackCenter = trackRect.left + trackRect.width / 2;
        let closestIndex = 0;
        let minDiff = Infinity;
        cards.forEach((card, i) => {
          const cardRect = card.getBoundingClientRect();
          const cardCenter = cardRect.left + cardRect.width / 2;
          const diff = Math.abs(trackCenter - cardCenter);
          if (diff < minDiff) {
            minDiff = diff;
            closestIndex = i;
          }
        });
        updateDots(closestIndex);
      }, 80);
    }, { passive: true });
  }

  setupTestimonialsCarousel();
  document.addEventListener("astro:page-load", setupTestimonialsCarousel);
</script>

